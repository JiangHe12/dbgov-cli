{
  "apiVersion": "dbgov.io/v1",
  "kind": "Capabilities",
  "success": true,
  "data": {
    "tool": {
      "name": "dbgov",
      "version": "dev"
    },
    "supported": {
      "contextApiVersion": "dbgov.io/context/v1",
      "auditApiVersion": "dbgov.io/audit/v1",
      "engines": [
        {
          "name": "mysql",
          "status": "available",
          "rollback": {
            "ddl": "none",
            "data": "irreversible",
            "notes": [
              "DDL uses implicit commit; rollback uses structural snapshot guidance only.",
              "Deleted data cannot be reconstructed by dbgov."
            ]
          }
        },
        {
          "name": "postgres",
          "status": "available",
          "rollback": {
            "ddl": "structural-snapshot",
            "data": "irreversible",
            "notes": [
              "PostgreSQL supports query, explain, schema workflows, governed DML, import, reconcile, and rollback.",
              "Rollback restores schema structure from snapshots only.",
              "Deleted data cannot be reconstructed by dbgov."
            ]
          }
        }
      ],
      "schema": "MySQL and PostgreSQL schema diff/plan/apply manage normalized autoIncrement columns; serial-vs-identity, ALWAYS-vs-BY-DEFAULT, and sequence options are not preserved.",
      "riskModel": [
        {
          "level": "R0",
          "authorization": "free"
        },
        {
          "level": "R1",
          "authorization": "--yes or interactive confirmation"
        },
        {
          "level": "R2",
          "authorization": "--yes plus --ticket"
        },
        {
          "level": "R3",
          "authorization": "--yes plus --ticket plus operation-specific --allow-* flag"
        }
      ],
      "allowFlags": [
        "--allow-destructive",
        "--allow-no-where",
        "--allow-production-prune"
      ],
      "governance": {
        "audit": "append-only JSONL with optional age encryption",
        "rbac": "opt-in roles reader/writer/admin",
        "dryRun": true,
        "otel": true
      }
    }
  }
}
